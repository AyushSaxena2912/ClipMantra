{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite preview --port 5180 --host",
    "restart": "lsof -ti:5180 | xargs kill -9 2>/dev/null || true",
    "dev:build": "npm run build && npm run restart && npm run dev",
    "build": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css && vite build",
    "tw:build": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css",
    "tw:watch": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css --watch",
    "lint": "eslint .",
    "preview": "vite preview --port 5180 --host"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.9",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
